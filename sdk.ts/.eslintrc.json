{
	"root": true,
	"ignorePatterns": [
		"node_modules/**"
	],
	"overrides": [
		{
			"files": [
				"**/*.ts"
			],
			"parser": "@typescript-eslint/parser",
			"parserOptions": {
				"ecmaVersion": "latest",
				"sourceType": "module"
			},
			"rules": {
				"quotes": [
					"error",
					"single",
					{
						"avoidEscape": true
					}
				],
				"semi": [
					"error",
					"never"
				]
			}
		}
	]
}
