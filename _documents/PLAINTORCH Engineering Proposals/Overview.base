summaries:
  Unique: values.unique().length
  Open: values.filter(value == 'available').length + ' [+' + values.filter( value == 'draft').length + ']'
filters:
  and:
    - file.folder == "Project Everglow/Moonlight Impact 3rd/PLAINTORCH/PLAINTORCH Engineering Proposals"
    - /(PEP|SEP)[0-9]{3} - .+/.matches(file.name)
properties:
  note.status:
    displayName: Status
  file.name:
    displayName: Title
  note.assignee:
    displayName: Assignee
  note.phase:
    displayName: Phase
views:
  - type: table
    name: Table
    order:
      - file.name
      - status
      - phase
    sort:
      - property: file.name
        direction: ASC
      - property: patches
        direction: ASC
    summaries:
      status: Open
      assignee: Unique
    imageAspectRatio: 0.95
    cardSize: 400
    separator: --
    indentProperties: true
    markers: none
    columnSize:
      file.name: 511
      note.status: 109
      note.phase: 77
  - type: list
    name: p2a
    filters:
      and:
        - phase == "2a"
    order:
      - file.name
      - status
    markers: none
  - type: list
    name: p1
    filters:
      and:
        - phase == "1"
    order:
      - file.name
      - status
    markers: none
  - type: list
    name: Patches
    order:
      - file.name
      - patches
    indentProperties: true
    markers: none
  - type: table
    name: Open
    order:
      - file.name
      - status
      - assignee
    sort:
      - property: file.name
        direction: ASC
      - property: patches
        direction: ASC
    summaries:
      status: Open
    imageAspectRatio: 0.95
    cardSize: 400
    separator: --
    indentProperties: true
    markers: none
    columnSize:
      file.name: 439
      note.status: 117
  - type: list
    name: Phases
    order:
      - file.name
    markers: none
    indentProperties: true
  - type: list
    name: p3a
    filters:
      and:
        - phase == "3a"
    order:
      - file.name
      - status
    markers: none
  - type: list
    name: p3b
    filters:
      and:
        - phase == "3b"
    order:
      - file.name
      - status
    markers: none
  - type: list
    name: p4q
    filters:
      and:
        - phase == "4"
    order:
      - file.name
      - status
    markers: none
  - type: list
    name: p4s
    filters:
      and:
        - phase == "5"
    order:
      - file.name
      - status
    markers: none
