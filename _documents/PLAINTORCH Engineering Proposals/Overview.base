summaries:
  Unique: values.unique().length
  Open: values.filter(value == 'available').length + ' [+' + values.filter( value == 'draft').length + ']'
filters:
  and:
    - file.folder == "Project Everglow/Moonlight Impact 3rd/PLAINTORCH/PLAINTORCH Engineering Proposals"
    - /PEP[0-9]{3} - .+/.matches(file.name)
properties:
  note.status:
    displayName: Status
  file.name:
    displayName: Title
views:
  - type: table
    name: Table
    order:
      - file.name
      - status
      - assignee
    sort:
      - property: file.name
        direction: ASC
      - property: patches
        direction: ASC
    summaries:
      status: Open
      file.name: new summary
    imageAspectRatio: 0.95
    cardSize: 400
    separator: --
    indentProperties: true
    markers: none
    columnSize:
      file.name: 439
      note.status: 117
  - type: list
    name: Patches
    order:
      - file.name
      - patches
    indentProperties: true
    markers: none
