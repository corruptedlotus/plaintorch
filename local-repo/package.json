{
	"name": "@corruptedlotus/local-repo",
	"version": "0.1.0",
	"description": "An identity-keyed store of canonical entity instances, typed repositories over any backend, and Lit bindings that keep every surface showing an entity in step — the frontend side of a one-authority-many-observers boundary.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepack": "npm run build"
	},
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./lit": {
			"source": "./lit/index.ts",
			"types": "./dist/lit/index.d.ts",
			"default": "./dist/lit/index.js"
		},
		"./testing": {
			"source": "./testing.ts",
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"peerDependencies": {
		"@a11d/lit": "^0.11.1"
	},
	"devDependencies": {
		"@a11d/lit": "0.11.1",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"happy-dom": "^20.14.6",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	}
}
